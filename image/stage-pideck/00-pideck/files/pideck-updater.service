[Unit]
Description=PiDeck restricted update service
After=local-fs.target

[Service]
Type=simple
RuntimeDirectory=pideck-updater
RuntimeDirectoryMode=0755
Environment=PYTHONPATH=/usr/lib/pideck-updater/python
ExecStart=/usr/bin/python3 -m pideck.infrastructure.image_update_daemon serve
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
