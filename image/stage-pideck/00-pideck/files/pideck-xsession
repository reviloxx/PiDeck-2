#!/bin/sh
set -eu

if ! xset s off -dpms; then
    echo "Unable to disable X11 screen blanking or DPMS." >&2
fi

SESSION_OPENBOX=/usr/lib/pideck/current/python/pideck/infrastructure/session/openbox-rc.xml
if [ -f "$SESSION_OPENBOX" ]; then
    OPENBOX_RC="$SESSION_OPENBOX"
else
    OPENBOX_RC=/usr/share/pideck/openbox/rc.xml
fi
if [ -f "$OPENBOX_RC" ]; then
    openbox --config-file "$OPENBOX_RC" &
else
    openbox &
fi
window_manager=$!
attempt=0
while ! wmctrl -m >/dev/null 2>&1; do
    if ! kill -0 "$window_manager" 2>/dev/null; then
        echo "Openbox failed to start." >&2
        exit 1
    fi
    if [ "$attempt" -ge 100 ]; then
        echo "Openbox did not become ready." >&2
        kill "$window_manager"
        exit 1
    fi
    attempt=$((attempt + 1))
    sleep 0.1
done

# Chromium-family browsers read this for client-side window buttons.
if command -v gsettings >/dev/null 2>&1; then
    gsettings set org.gnome.desktop.wm.preferences button-layout ':close' >/dev/null 2>&1 || true
fi

# Composite fullscreen apps so the session overlay can blur what is on screen.
# Prefer the updatable release profile for this GPU / VM; fall back for recovery.
if command -v picom >/dev/null 2>&1; then
    SESSION_PICOM=/usr/lib/pideck/current/python/pideck/infrastructure/session
    if [ -r /proc/driver/nvidia/version ] && [ -f "$SESSION_PICOM/picom-nvidia.conf" ]; then
        PICOM_CONF="$SESSION_PICOM/picom-nvidia.conf"
    elif command -v systemd-detect-virt >/dev/null 2>&1 \
        && systemd-detect-virt >/dev/null 2>&1 \
        && [ -f "$SESSION_PICOM/picom-vm.conf" ]; then
        PICOM_CONF="$SESSION_PICOM/picom-vm.conf"
    elif [ -f "$SESSION_PICOM/picom.conf" ]; then
        PICOM_CONF="$SESSION_PICOM/picom.conf"
    else
        PICOM_CONF=/usr/lib/pideck/picom.conf
    fi
    picom --config "$PICOM_CONF" &
fi

exec /usr/bin/python3 -m pideck.bootstrap \
    --config "$PIDECK_CONFIG" \
    --asset-root "$PIDECK_ASSET_ROOT" \
    --power-off-on-shutdown
