// Let the PiDeck session user mount, unmount and safely remove data drives
// from Settings > System > Drives without an administrator password.
polkit.addRule(function(action, subject) {
    if (subject.local && subject.active && subject.isInGroup("plugdev") &&
        (action.id.indexOf("org.freedesktop.udisks2.filesystem-mount") === 0 ||
         action.id === "org.freedesktop.udisks2.filesystem-unmount-others" ||
         action.id.indexOf("org.freedesktop.udisks2.power-off-drive") === 0 ||
         action.id.indexOf("org.freedesktop.udisks2.eject-media") === 0)) {
        return polkit.Result.YES;
    }
});
