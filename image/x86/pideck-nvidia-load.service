[Unit]
Description=Load NVIDIA DRM for PiDeck
DefaultDependencies=no
After=systemd-udevd.service
Before=getty@tty1.service
Wants=systemd-udevd.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Soft-fail on machines without an NVIDIA GPU so Intel/AMD images still boot.
ExecStart=-/sbin/modprobe nvidia-drm
# Re-show the splash after NVIDIA modeset replaces the early efifb frame.
ExecStartPost=-/usr/bin/plymouth show-splash
TimeoutStartSec=30

[Install]
WantedBy=sysinit.target
