#!/bin/sh
# Keep GPU drivers (including proprietary NVIDIA DKMS) and their firmware out
# of the initramfs image. The Plymouth hook would otherwise add over 100 MiB
# that the bootloader must read from slow media. NVIDIA is loaded from the
# mounted root in scripts/local-bottom/pideck-nvidia before switch_root.
set -e

PREREQ="plymouth"

prereqs()
{
	echo "${PREREQ}"
}

case "${1}" in
	prereqs)
		prereqs
		exit 0
		;;
esac

# initramfs-tools copies queued modules and their firmware after all hooks run.
gpu_modules="${MODULESDIR}/kernel/drivers/gpu"
if [ -n "${__MODULES_TO_ADD:-}" ] && [ -f "${__MODULES_TO_ADD}" ] && [ -d "${gpu_modules}" ]; then
	excluded="$(mktemp)"
	find "${gpu_modules}" -name '*.ko*' -printf '%f\n' | sed 's/\..*//' | sort -u > "${excluded}"
	filtered="$(mktemp)"
	# NVIDIA DKMS modules live outside drivers/gpu and may be queued by alias.
	grep -vxF -f "${excluded}" "${__MODULES_TO_ADD}" | grep -v '^nvidia' > "${filtered}" || true
	cat "${filtered}" > "${__MODULES_TO_ADD}"
	rm -f "${excluded}" "${filtered}"
fi

for base in "${DESTDIR}/usr/lib" "${DESTDIR}/lib"; do
	rm -rf "${base}/modules/${version}/kernel/drivers/gpu"
	find "${base}/modules/${version}/updates" -name 'nvidia*.ko*' -delete 2>/dev/null || true
	for firmware in amdgpu i915 nvidia radeon xe; do
		rm -rf "${base}/firmware/${firmware}"
	done
done
